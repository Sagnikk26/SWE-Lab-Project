# Server Port Configuration
PORT=5000

# MongoDB Atlas Connection URI
# Replace <username>, <password>, and <cluster-url> with your MongoDB Atlas cluster credentials.
# Database name can be set to 'uem_admission' or your preferred database.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/uem_admission?retryWrites=true&w=majority

# JWT Authentication Secret
# Provide a strong, high-entropy secret key for signing authentication tokens
JWT_SECRET=your_jwt_secret_key_here
